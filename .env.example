# Copie para ".env" e ajuste se necessário:  cp .env.example .env
# O Docker Compose lê o .env automaticamente. Nenhuma chave de API é necessária:
# o DocAI roda 100% local.

# URL do servidor Ollama usada pelo app (app.py) e pela suíte de testes.
#  - Execução manual (Python/venv no host): http://localhost:11434
#  - Dentro do Docker Compose o serviço já recebe http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# Portas publicadas no host pelo docker-compose.yml
DOCAI_PORT=8501
OLLAMA_PORT=11434

# Modelo LLM usado nos testes de geração (tests/test_rag_pipeline.py)
DOCAI_TEST_MODEL=llama3.1:8b

# Diretórios (fixos no código; listados aqui apenas como referência)
#  - Documentos-fonte:  ./documentos
#  - Base vetorial:     ./chroma_db   (gerada pela indexação; não versionada)
